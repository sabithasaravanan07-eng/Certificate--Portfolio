# Copy to .env for local use. Keep the actual .env file private.
# Leave DATABASE_URL blank to use local SQLite.
DATABASE_URL=
# Optional Supabase Storage settings. Create a private bucket named certificate-uploads.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=certificate-uploads
# Optional: Supabase Database Settings -> SSL Configuration -> Download certificate.
# Pair this certificate with sslmode=verify-full for server identity verification.
DATABASE_SSLROOTCERT=
# For Supabase, paste the PostgreSQL URI from Project Settings -> Database.
# Use the session pooler URI if your hosting provider cannot reach the direct connection.
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-strong-password-of-10+-characters
# Local SQLite and uploads use DATA_DIR. With Supabase Storage configured, uploads use the bucket.
DATA_DIR=./data
# Set to 1 when the site runs on https (production). Use 0 for local http.
COOKIE_SECURE=0
# Public profile details (comma-separated lists use commas between items).
OWNER_NAME=Sabitha S
OWNER_ABOUT=Information Technology student at The Kavery Engineering College, interested in web and full-stack development.
OWNER_FOCUS=Curious and driven, with an interest in building clean and functional web experiences.
OWNER_EDUCATION=B.Tech in Information Technology — The Kavery Engineering College, Full Stack Development certification — Novi Tech, HDCA six-month course — TCDS
OWNER_SPECIALTIES=HTML5, CSS3, JavaScript, Python, Flask, MySQL, Git, GitHub
OWNER_HIGHLIGHTS=My Brain Battle team won two prizes, Participated in a code-debugging event
OWNER_LOCATION=Salem, Tamil Nadu, India
CONTACT_EMAIL=you@example.com
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username
PORTFOLIO_URL=https://your-personal-portfolio.example
